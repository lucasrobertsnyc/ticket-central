# Copy this file to .env.local and fill in your credentials.
# Never commit .env.local — it is listed in .gitignore.

# ─── Ticketmaster Discovery API ───────────────────────────────────────────────
# Get a free key at https://developer.ticketmaster.com/ → "Get an API Key"
# Quota: 5,000 calls/day · 5 req/sec on the free tier.
# Only TICKETMASTER_API_KEY (the Consumer Key) is required for API calls.
TICKETMASTER_API_KEY=
TICKETMASTER_API_SECRET=

# ─── SeatGeek Platform API ────────────────────────────────────────────────────
# Free credentials at https://platform.seatgeek.com/
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# ─── Spotify Web API (artist images) ─────────────────────────────────────────
# https://developer.spotify.com/dashboard → create an app → copy Client ID + Secret
# When set, stock photos are replaced with official Spotify artist press photos.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
